# Local-only deploy trigger credentials for scripts/ship.sh. NOT committed.
# Same VPS as Game Pulse; release_bot lives separately at /opt/release_bot.
# Copy to .env.local and fill in (values are in game_pulse_saas/.env.local).
VPS_HOST=162.55.137.149
VPS_USER=dev01
VPS_PORT=1996
# Key path must be authorized for dev01 on the new VM. Leading ~/ is supported.
VPS_SSH_IDENTITY_FILE=~/.ssh/id_ed25519
# Optional legacy password auth, used only when identity path is empty.
VPS_PASSWORD=
